# 1Panel (v2 API only)
PANEL_BASE_URL=https://panel.example.com
PANEL_API_KEY=

# Ask 1Panel to issue a certificate when no existing one covers a CDN domain.
PANEL_ISSUE_CERT=false
# Leave IDs empty to use the first ACME/DNS account, or set explicit IDs.
PANEL_ACME_ACCOUNT_ID=
PANEL_DNS_ACCOUNT_ID=
PANEL_KEY_TYPE=EC256
PANEL_ISSUE_PROVIDER=dnsAccount
PANEL_CERT_AUTO_RENEW=true
PANEL_ISSUE_TIMEOUT=15m
PANEL_ISSUE_RETRIES=3
PANEL_ISSUE_RETRY_DELAY=2m

# Qiniu CDN
QINIU_AK=
QINIU_SK=
QINIU_FORCE_HTTPS=false
QINIU_HTTP2=true
QINIU_TLS_VERSIONS=TLSv1.1/TLSv1.2/TLSv1.3

# Upyun: token is used for read-only listing/state.
UPYUN_TOKEN=
# Username/password enable the console session required for upload/bind.
UPYUN_USERNAME=
UPYUN_PASSWORD=
UPYUN_FORCE_HTTPS=false
UPYUN_SOURCE_HTTPS=false

# Renew when the bound certificate has fewer days left than this.
RENEW_BEFORE_DAYS=30

# Probe the real edge certificate over TLS. Recommended where DNS is not proxied.
VERIFY_TLS=false
TLS_PROBE_TIMEOUT=10s
EDGE_WAIT_TIMEOUT=10m

# Optional allow/deny lists (comma separated).
INCLUDE_DOMAINS=
EXCLUDE_DOMAINS=
